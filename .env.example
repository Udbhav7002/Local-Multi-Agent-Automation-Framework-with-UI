# Model Configurations
MANAGER_MODEL=qwen3-coder:30b
WORKER_MODEL=qwen2.5-coder:14b
VISION_MODEL=qwen2.5vl:7b
CRITIC_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Context & Timeouts
NUM_CTX=8192
CLI_TIMEOUT_SECONDS=60.0
CLI_MAX_OUTPUT_CHARS=2000
LLM_TIMEOUT_SECONDS=120.0

# Plan Execution
MAX_PLAN_REGENERATIONS=3
MAX_STEP_RETRIES=1

# System Context (Optional: Override auto-detection)
# OS_CONTEXT="macOS"

# Memory Thresholds (Cosine Distance)
MEMORY_SUCCESS_THRESHOLD=0.15
MEMORY_FAILURE_THRESHOLD=0.20
MEMORY_EPISODE_THRESHOLD=0.25

# Logging
DEBUG=False
ENABLE_JSON_LOGGING=True
